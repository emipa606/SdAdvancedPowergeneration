  <!-- EN: advanced geothermal generator -->
  <sd_adv_powergen_adv_geothermal_generator.label>高级地热发电机</sd_adv_powergen_adv_geothermal_generator.label>
  <!-- EN: Produces electricity from geothermal steam geysers. Must be placed on a geyser.\n	Energy Output: 7500 -->
  <sd_adv_powergen_adv_geothermal_generator.description>利用地热蒸汽间歇泉发电。必须放置在间歇泉上。
  能量输出：7500</sd_adv_powergen_adv_geothermal_generator.description>
  <!-- EN: advanced solar generator -->
  <sd_adv_powergen_adv_solar_generator.label>高级太阳能发电机</sd_adv_powergen_adv_solar_generator.label>
  <!-- EN: Produces electricity from sunlight. Does not work in the dark. Energy Output: 3400 at max -->
  <sd_adv_powergen_adv_solar_generator.description>利用阳光发电。在黑暗中无法工作。能量输出：最大值 3400</sd_adv_powergen_adv_solar_generator.description>
  <!-- EN: advanced wind turbine -->
  <sd_adv_powergen_adv_wind_turbine.label>高级风力涡轮机</sd_adv_powergen_adv_wind_turbine.label>
  <!-- EN: A wind-powered electrical generator. Requires a large clear space in front and behind for optimal air flow.\n	Energy Output: 6000 at max -->
  <sd_adv_powergen_adv_wind_turbine.description>一台风力发电机。为确保最佳气流，其前方和后方需留出宽敞的空地。
  能量输出：最大6000</sd_adv_powergen_adv_wind_turbine.description>
  <!-- EN: advanced nuclear power plant -->
  <sd_adv_powergen_nuclear_power_plant.label>高级核电站</sd_adv_powergen_nuclear_power_plant.label>
  <!-- EN: Produces electricity from uranium. Can be placed anywhere.\n	Energy Output: 20000 -->
  <sd_adv_powergen_nuclear_power_plant.description>利用铀发电。可放置在任意位置。
  能量输出：20000</sd_adv_powergen_nuclear_power_plant.description>
  <!-- EN: advanced watermill generator -->
  <sd_adv_powergen_WatermillGenerator.label>高级水车发电机</sd_adv_powergen_WatermillGenerator.label>
  <!-- EN: Produces electricity from a river. Must be placed with its wheel in moving water. If watermills are placed too close together, the turbulence they generate will interfere and reduce power generation.\n	Energy Output: 2200 -->
  <sd_adv_powergen_WatermillGenerator.description>利用河流发电。放置时，其水轮必须位于流动的水中。如果水车放置得过近，它们产生的湍流会相互干扰，从而降低发电量。
  能量输出：2200</sd_adv_powergen_WatermillGenerator.description>
